{
  "name": "stylelint-config-generator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint:format": "oxfmt --check",
    "lint:js": "oxlint src",
    "lint:css": "stylelint \"src/**/*.{css,ts,tsx}\"",
    "lint": "npm run lint:format && npm run lint:js && npm run lint:css",
    "prepare": "husky"
  },
  "dependencies": {
    "@reatom/core": "1001.3.0",
    "@reatom/react": "1001.0.1",
    "normalize.css": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "styled-components": "6.5.3",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-standard": "40.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss-styled-syntax": "0.7.3",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
